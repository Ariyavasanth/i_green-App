rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // On-Duty action proof photos (cancel, pause, resume, reached, work)
    match /on_duty/{assignmentId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Default authenticated access
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}

